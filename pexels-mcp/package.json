{
  "name": "pexels-mcp",
  "version": "1.0.0",
  "description": "MCP server untuk mencari gambar dan video pendek dari Pexels API. Dapat di-install di sistem manapun termasuk Trae IDE.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pexels-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "pexels",
    "images",
    "videos",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
